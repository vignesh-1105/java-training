public class reversetwo {
    public static void main(String[]args){
        int [] arr = {2,1,3,1,2,1};
        int left = 0;
        int right = arr.length-1;
        while (left<right){
            int temp = arr[left];
            arr [left] = arr [right];
            arr [right] = temp;
            left++;
            right--;
        }
        System.out.print("the reversetwo array is: ");
        for (int value : arr) {
            System.out.print(value + " ");

        }
    }

    }
